<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
   Ventana de combos (se abre desde "Generar venta").
   Las imágenes son FIJAS: en Scene Builder selecciona cada ImageView (imgPersonal, imgPareja...)
   y en "Image" elige el archivo dentro de recursosGraficos.
   Si cambias precios en Combo.java, actualiza también los textos de aquí.
-->
<AnchorPane fx:id="rootPane" prefHeight="920.0" prefWidth="1500.0" style="-fx-background-color: black;" stylesheets="@gestion.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cineuq.proyectofinalprogramacion1cineuq.viewController.CombosViewController">
   <children>
      <Label layoutX="37.0" layoutY="25.0" styleClass="titulo-panel" text="Elige los combos" />
      <Label layoutX="37.0" layoutY="62.0" styleClass="etiqueta" text="Usa + y − para agregar o quitar unidades. Luego pulsa &quot;Listo&quot;." />

      <GridPane hgap="30.0" layoutX="37.0" layoutY="100.0" vgap="30.0">
         <children>
            <!-- ===== COMBO PERSONAL ===== -->
            <VBox prefWidth="455.0" spacing="8.0" styleClass="tarjeta-combo" GridPane.columnIndex="0" GridPane.rowIndex="0">
               <children>
                  <StackPane prefHeight="190.0" styleClass="marco-imagen">
                     <children>
                        <Label styleClass="sin-imagen" text="Imagen del combo (agrégala en Scene Builder)" />
                        <ImageView fx:id="imgPersonal" fitHeight="190.0" fitWidth="425.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Label styleClass="nombre-combo" text="Combo Personal" />
                  <Label styleClass="etiqueta" text="Crispetas medianas + gaseosa mediana" wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label maxWidth="Infinity" styleClass="dato" text="\$18.000" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onQuitar" styleClass="boton-cantidad" text="−" userData="PERSONAL" />
                        <Label fx:id="lblCantPersonal" styleClass="cantidad-combo" text="0" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-cantidad" text="+" userData="PERSONAL" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ===== COMBO PAREJA ===== -->
            <VBox prefWidth="455.0" spacing="8.0" styleClass="tarjeta-combo" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <children>
                  <StackPane prefHeight="190.0" styleClass="marco-imagen">
                     <children>
                        <Label styleClass="sin-imagen" text="Imagen del combo (agrégala en Scene Builder)" />
                        <ImageView fx:id="imgPareja" fitHeight="190.0" fitWidth="425.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Label styleClass="nombre-combo" text="Combo Pareja" />
                  <Label styleClass="etiqueta" text="Crispetas grandes + 2 gaseosas medianas" wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label maxWidth="Infinity" styleClass="dato" text="\$32.000" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onQuitar" styleClass="boton-cantidad" text="−" userData="PAREJA" />
                        <Label fx:id="lblCantPareja" styleClass="cantidad-combo" text="0" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-cantidad" text="+" userData="PAREJA" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ===== COMBO FAMILIAR ===== -->
            <VBox prefWidth="455.0" spacing="8.0" styleClass="tarjeta-combo" GridPane.columnIndex="2" GridPane.rowIndex="0">
               <children>
                  <StackPane prefHeight="190.0" styleClass="marco-imagen">
                     <children>
                        <Label styleClass="sin-imagen" text="Imagen del combo (agrégala en Scene Builder)" />
                        <ImageView fx:id="imgFamiliar" fitHeight="190.0" fitWidth="425.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Label styleClass="nombre-combo" text="Combo Familiar" />
                  <Label styleClass="etiqueta" text="2 crispetas grandes + 4 gaseosas + chocolatina" wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label maxWidth="Infinity" styleClass="dato" text="\$52.000" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onQuitar" styleClass="boton-cantidad" text="−" userData="FAMILIAR" />
                        <Label fx:id="lblCantFamiliar" styleClass="cantidad-combo" text="0" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-cantidad" text="+" userData="FAMILIAR" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ===== COMBO NACHOS ===== -->
            <VBox prefWidth="455.0" spacing="8.0" styleClass="tarjeta-combo" GridPane.columnIndex="0" GridPane.rowIndex="1">
               <children>
                  <StackPane prefHeight="190.0" styleClass="marco-imagen">
                     <children>
                        <Label styleClass="sin-imagen" text="Imagen del combo (agrégala en Scene Builder)" />
                        <ImageView fx:id="imgNachos" fitHeight="190.0" fitWidth="425.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Label styleClass="nombre-combo" text="Combo Nachos" />
                  <Label styleClass="etiqueta" text="Nachos con queso cheddar + gaseosa grande" wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label maxWidth="Infinity" styleClass="dato" text="\$24.000" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onQuitar" styleClass="boton-cantidad" text="−" userData="NACHOS" />
                        <Label fx:id="lblCantNachos" styleClass="cantidad-combo" text="0" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-cantidad" text="+" userData="NACHOS" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ===== COMBO PERRO CALIENTE ===== -->
            <VBox prefWidth="455.0" spacing="8.0" styleClass="tarjeta-combo" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <StackPane prefHeight="190.0" styleClass="marco-imagen">
                     <children>
                        <Label styleClass="sin-imagen" text="Imagen del combo (agrégala en Scene Builder)" />
                        <ImageView fx:id="imgPerro" fitHeight="190.0" fitWidth="425.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Label styleClass="nombre-combo" text="Combo Perro Caliente" />
                  <Label styleClass="etiqueta" text="Perro caliente + crispetas pequeñas + gaseosa" wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label maxWidth="Infinity" styleClass="dato" text="\$26.000" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onQuitar" styleClass="boton-cantidad" text="−" userData="PERRO" />
                        <Label fx:id="lblCantPerro" styleClass="cantidad-combo" text="0" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-cantidad" text="+" userData="PERRO" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ===== COMBO INFANTIL ===== -->
            <VBox prefWidth="455.0" spacing="8.0" styleClass="tarjeta-combo" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <children>
                  <StackPane prefHeight="190.0" styleClass="marco-imagen">
                     <children>
                        <Label styleClass="sin-imagen" text="Imagen del combo (agrégala en Scene Builder)" />
                        <ImageView fx:id="imgInfantil" fitHeight="190.0" fitWidth="425.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <Label styleClass="nombre-combo" text="Combo Infantil" />
                  <Label styleClass="etiqueta" text="Crispetas pequeñas + jugo + juguete sorpresa" wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label maxWidth="Infinity" styleClass="dato" text="\$16.000" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onQuitar" styleClass="boton-cantidad" text="−" userData="INFANTIL" />
                        <Label fx:id="lblCantInfantil" styleClass="cantidad-combo" text="0" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-cantidad" text="+" userData="INFANTIL" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" layoutX="37.0" layoutY="840.0" prefWidth="1425.0" spacing="20.0">
         <children>
            <VBox maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblSubtotal" styleClass="dato" text="Subtotal combos: \$0" />
                  <Label styleClass="etiqueta" text="El descuento del plan del cliente se aplica al registrar la venta." />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#onQuitarTodos" prefWidth="180.0" styleClass="boton-secundario" text="Quitar todos" />
            <Button mnemonicParsing="false" onAction="#onListo" prefWidth="220.0" styleClass="boton-principal" text="Listo" />
         </children>
      </HBox>
   </children>
</AnchorPane>
