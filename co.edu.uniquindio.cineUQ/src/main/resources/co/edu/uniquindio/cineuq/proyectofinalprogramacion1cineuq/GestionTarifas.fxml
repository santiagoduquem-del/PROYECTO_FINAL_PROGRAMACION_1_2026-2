<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" prefHeight="1200.0" prefWidth="1920.0" style="-fx-background-color: black;" stylesheets="@gestion.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cineuq.proyectofinalprogramacion1cineuq.viewController.GestionTarifasViewController">
   <children>
      <!-- Barra superior -->
      <Pane layoutX="86.0" layoutY="37.0" prefHeight="59.0" prefWidth="1776.0" style="-fx-background-color: #111111; -fx-background-radius: 54;">
         <children>
            <Button layoutX="6.0" layoutY="9.0" mnemonicParsing="false" onAction="#onAtras" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px; -fx-cursor: hand;" text="←" />
            <Text fill="WHITE" layoutX="56.0" layoutY="35.0" text="CinemaUQ®">
               <font><Font name="SansSerif Bold" size="18.0" /></font>
            </Text>
            <Button layoutX="770.0" layoutY="9.0" mnemonicParsing="false" onAction="#onHome" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="Home" />
            <Button layoutX="407.0" layoutY="9.0" mnemonicParsing="false" onAction="#onDolby" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 21px; -fx-cursor: hand;" text="dolby ◗◖" />
            <Button layoutX="925.0" layoutY="9.0" mnemonicParsing="false" onAction="#onMasFormatos" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="Más formatos" />
            <Button layoutX="1129.0" layoutY="9.0" mnemonicParsing="false" onAction="#onImax" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="IMAX" />
            <Pane layoutX="1430.0" prefHeight="59.0" prefWidth="346.0" style="-fx-background-color: #b81414; -fx-background-radius: 54;">
               <children>
                  <Text fill="WHITE" layoutX="95.0" layoutY="36.0" text="Gestionar tarifas">
                     <font><Font name="SansSerif Bold" size="18.0" /></font>
                  </Text>
               </children>
            </Pane>
         </children>
      </Pane>

      <Button layoutX="86.0" layoutY="108.0" mnemonicParsing="false" onAction="#onVolver" styleClass="boton-volver" text="← Volver al menú" />

      <HBox layoutX="86.0" layoutY="165.0" prefHeight="1000.0" prefWidth="1776.0" spacing="30.0">
         <children>
            <VBox prefWidth="520.0" spacing="12.0" styleClass="panel">
               <children>
                  <Label styleClass="titulo-panel" text="Modificar tarifa" />
                  <Label styleClass="etiqueta" text="El valor de cada tipo de entrada es lo que paga el cliente al comprar." wrapText="true" />
                  <Label styleClass="etiqueta" text="Tipo de entrada" />
                  <ComboBox fx:id="cbTipoEntrada" maxWidth="Infinity" promptText="Seleccione el tipo" styleClass="campo" />
                  <Label styleClass="etiqueta" text="Nuevo valor" />
                  <TextField fx:id="txtValor" onAction="#onModificar" promptText="15000" styleClass="campo" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onModificar" styleClass="boton-principal" text="Guardar tarifa" />
                  <Label styleClass="etiqueta" text="Las ventas ya realizadas conservan el valor que se pagó." wrapText="true" />
                  <Label styleClass="titulo-panel" text="Membresías" />
                  <Label styleClass="etiqueta" text="Precio mensual y descuentos de los planes Free, Básico, Estándar y Premium." wrapText="true" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onGestionarMembresias" styleClass="boton-secundario" text="Gestionar membresías" />
               </children>
            </VBox>
            <VBox spacing="12.0" styleClass="panel" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-panel" text="Tarifas vigentes" />
                  <TableView fx:id="tablaTarifas" onMouseClicked="#onSeleccionarTarifa" styleClass="tabla" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colTipo" prefWidth="500.0" text="Tipo de entrada" />
                        <TableColumn fx:id="colValor" prefWidth="500.0" text="Valor" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
