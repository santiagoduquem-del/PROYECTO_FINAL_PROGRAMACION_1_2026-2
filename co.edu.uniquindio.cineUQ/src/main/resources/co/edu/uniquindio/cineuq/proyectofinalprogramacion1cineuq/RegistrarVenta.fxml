<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" prefHeight="1200.0" prefWidth="1920.0" style="-fx-background-color: black;" stylesheets="@gestion.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cineuq.proyectofinalprogramacion1cineuq.viewController.RegistrarVentaViewController">
   <children>
      <!-- Barra superior -->
      <Pane layoutX="86.0" layoutY="37.0" prefHeight="59.0" prefWidth="1776.0" style="-fx-background-color: #111111; -fx-background-radius: 54;">
         <children>
            <Button layoutX="6.0" layoutY="9.0" mnemonicParsing="false" onAction="#onAtras" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px; -fx-cursor: hand;" text="←" />
            <Text fill="WHITE" layoutX="56.0" layoutY="35.0" text="CinemaUQ®">
               <font><Font name="SansSerif Bold" size="18.0" /></font>
            </Text>
            <Button layoutX="770.0" layoutY="9.0" mnemonicParsing="false" onAction="#onHome" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="Home" />
            <Button layoutX="407.0" layoutY="9.0" mnemonicParsing="false" onAction="#onDolby" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 21px; -fx-cursor: hand;" text="dolby ◗◖" />
            <Button layoutX="925.0" layoutY="9.0" mnemonicParsing="false" onAction="#onMasFormatos" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="Más formatos" />
            <Button layoutX="1129.0" layoutY="9.0" mnemonicParsing="false" onAction="#onImax" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="IMAX" />
            <Pane layoutX="1430.0" prefHeight="59.0" prefWidth="346.0" style="-fx-background-color: #b81414; -fx-background-radius: 54;">
               <children>
                  <Text fill="WHITE" layoutX="38.0" layoutY="36.0" text="Generar venta de entrada">
                     <font><Font name="SansSerif Bold" size="18.0" /></font>
                  </Text>
               </children>
            </Pane>
         </children>
      </Pane>

      <Button layoutX="86.0" layoutY="108.0" mnemonicParsing="false" onAction="#onVolver" styleClass="boton-volver" text="← Volver al menú" />

      <HBox layoutX="86.0" layoutY="165.0" prefHeight="1000.0" prefWidth="1776.0" spacing="30.0">
         <children>
            <!-- Formulario de la venta: el título queda fijo y el resto va en un ScrollPane
                 para que los campos tengan espacio y la carátula se vea grande -->
            <VBox minWidth="560.0" prefWidth="560.0" spacing="12.0" styleClass="panel">
               <children>
                  <Label styleClass="titulo-panel" text="Datos de la venta" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #111111; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="10.0">
                           <padding><Insets right="14.0" /></padding>
                           <children>
                              <Label styleClass="etiqueta" text="Película" />
                              <ComboBox fx:id="cbPelicula" maxWidth="Infinity" onAction="#onSeleccionarPelicula" promptText="Seleccione la película" styleClass="campo" />
                              <HBox alignment="CENTER_LEFT" spacing="20.0">
                                 <children>
                                    <StackPane minHeight="240.0" minWidth="160.0" prefHeight="240.0" prefWidth="160.0" styleClass="marco-imagen">
                                       <children>
                                          <Label styleClass="sin-imagen" text="Sin carátula" />
                                          <ImageView fx:id="imgCaratula" fitHeight="240.0" fitWidth="160.0" preserveRatio="true" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="lblInfoPelicula" style="-fx-font-size: 17px; -fx-line-spacing: 4;" styleClass="etiqueta" text="Seleccione una película" wrapText="true" HBox.hgrow="ALWAYS" />
                                 </children>
                                 <padding><Insets bottom="8.0" top="6.0" /></padding>
                              </HBox>
                              <Label styleClass="etiqueta" text="Función" />
                              <ComboBox fx:id="cbFuncion" maxWidth="Infinity" onAction="#onSeleccionarFuncion" promptText="Seleccione la función" styleClass="campo" />
                              <Label styleClass="etiqueta" text="Cliente">
                                 <padding><Insets top="8.0" /></padding>
                              </Label>
                              <ComboBox fx:id="cbCliente" maxWidth="Infinity" onAction="#onSeleccionarCliente" promptText="Seleccione el cliente" styleClass="campo" />
                              <Label fx:id="lblPlan" style="-fx-text-fill: #f9a825;" styleClass="etiqueta" text="Seleccione un cliente para ver su plan" wrapText="true" />
                              <Label styleClass="etiqueta" text="Tipo de entrada">
                                 <padding><Insets top="8.0" /></padding>
                              </Label>
                              <ComboBox fx:id="cbTipoEntrada" maxWidth="Infinity" onAction="#onSeleccionarTipoEntrada" promptText="Seleccione el tipo de entrada" styleClass="campo" />
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Label fx:id="lblCombos" maxWidth="Infinity" styleClass="etiqueta" text="Sin combos" wrapText="true" HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#onElegirCombos" prefWidth="170.0" styleClass="boton-secundario" text="Elegir combos" />
                                 </children>
                                 <padding><Insets top="8.0" /></padding>
                              </HBox>
                              <HBox spacing="30.0">
                                 <children>
                                    <VBox minWidth="150.0" prefWidth="150.0" spacing="2.0">
                                       <children>
                                          <Label styleClass="etiqueta" text="Asientos" />
                                          <Label fx:id="lblAsiento" maxWidth="150.0" styleClass="dato" text="Ninguno" wrapText="true" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta" text="Total a pagar" />
                                          <Label fx:id="lblValor" styleClass="dato" text="\$0" />
                                          <Label fx:id="lblDetalleValor" maxWidth="Infinity" minHeight="-Infinity" style="-fx-font-size: 13px;" styleClass="etiqueta" text="0 entrada(s) x \$0 + combos \$0" wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                                 <padding><Insets top="8.0" /></padding>
                              </HBox>
                              <HBox spacing="15.0">
                                 <children>
                                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onVender" styleClass="boton-principal" text="Vender entradas" HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#onLimpiar" prefWidth="140.0" styleClass="boton-secundario" text="Limpiar" />
                                 </children>
                                 <padding><Insets top="10.0" /></padding>
                              </HBox>
                              <TextArea fx:id="txtTiquete" editable="false" minHeight="320.0" prefHeight="320.0" promptText="Aquí aparecerá la información de la entrada vendida" styleClass="tiquete" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>

            <!-- Mapa de asientos -->
            <VBox spacing="15.0" styleClass="panel" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-panel" text="Selecciona los asientos" />
                  <Label fx:id="lblDisponibilidad" styleClass="etiqueta" text="Seleccione una función para ver los asientos" />
                  <Label maxWidth="Infinity" prefHeight="30.0" styleClass="pantalla-cine" text="PANTALLA" />
                  <ScrollPane fitToWidth="true" styleClass="mapa" VBox.vgrow="ALWAYS">
                     <content>
                        <GridPane fx:id="gridAsientos" alignment="CENTER" hgap="8.0" vgap="8.0">
                           <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                        </GridPane>
                     </content>
                  </ScrollPane>
                  <HBox spacing="15.0">
                     <children>
                        <Label styleClass="asiento-disponible" text="Disponible" />
                        <Label styleClass="asiento-ocupado" text="Ocupado" />
                        <Label styleClass="asiento-seleccionado" text="Seleccionado" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
