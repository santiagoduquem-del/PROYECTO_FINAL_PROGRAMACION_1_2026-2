<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" prefHeight="1200.0" prefWidth="1920.0" style="-fx-background-color: black;" stylesheets="@gestion.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cineuq.proyectofinalprogramacion1cineuq.viewController.GestionSeccionesViewController">
   <children>
      <!-- Barra superior -->
      <Pane layoutX="86.0" layoutY="37.0" prefHeight="59.0" prefWidth="1776.0" style="-fx-background-color: #111111; -fx-background-radius: 54;">
         <children>
            <Button layoutX="6.0" layoutY="9.0" mnemonicParsing="false" onAction="#onAtras" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px; -fx-cursor: hand;" text="←" />
            <Text fill="WHITE" layoutX="56.0" layoutY="35.0" text="CinemaUQ®">
               <font><Font name="SansSerif Bold" size="18.0" /></font>
            </Text>
            <Button layoutX="770.0" layoutY="9.0" mnemonicParsing="false" onAction="#onHome" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="Home" />
            <Button layoutX="407.0" layoutY="9.0" mnemonicParsing="false" onAction="#onDolby" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 21px; -fx-cursor: hand;" text="dolby ◗◖" />
            <Button layoutX="925.0" layoutY="9.0" mnemonicParsing="false" onAction="#onMasFormatos" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="Más formatos" />
            <Button layoutX="1129.0" layoutY="9.0" mnemonicParsing="false" onAction="#onImax" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-cursor: hand;" text="IMAX" />
            <Pane layoutX="1430.0" prefHeight="59.0" prefWidth="346.0" style="-fx-background-color: #b81414; -fx-background-radius: 54;">
               <children>
                  <Text fill="WHITE" layoutX="80.0" layoutY="36.0" text="Secciones del detalle">
                     <font><Font name="SansSerif Bold" size="18.0" /></font>
                  </Text>
               </children>
            </Pane>
         </children>
      </Pane>

      <Button layoutX="86.0" layoutY="108.0" mnemonicParsing="false" onAction="#onVolver" styleClass="boton-volver" text="← Volver a películas" />

      <HBox layoutX="86.0" layoutY="165.0" prefHeight="1000.0" prefWidth="1776.0" spacing="30.0">
         <children>
            <!-- Formulario de una sección: etiqueta, título, texto y foto (solo título o texto son obligatorios) -->
            <VBox minWidth="560.0" prefWidth="560.0" spacing="10.0" styleClass="panel">
               <children>
                  <Label fx:id="lblPelicula" styleClass="titulo-panel" text="Película" wrapText="true" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #111111; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="etiqueta" text="Texto pequeño arriba (opcional)" />
                              <TextField fx:id="txtEtiqueta" promptText="EXCLUSIVO PARA MIEMBROS" styleClass="campo" />
                              <Label styleClass="etiqueta" text="Título" />
                              <TextField fx:id="txtTitulo" promptText="¡Participa en nuestro sorteo!" styleClass="campo" />
                              <Label styleClass="etiqueta" text="Texto" />
                              <TextArea fx:id="txtTexto" prefHeight="150.0" promptText="Cuéntale al cliente de qué se trata..." wrapText="true" />
                              <Label styleClass="etiqueta" text="Foto (opcional)" />
                              <StackPane prefHeight="300.0" styleClass="marco-imagen">
                                 <children>
                                    <Label styleClass="sin-imagen" text="Sin foto" />
                                    <ImageView fx:id="imgSeccion" fitHeight="300.0" fitWidth="480.0" preserveRatio="true" />
                                 </children>
                              </StackPane>
                              <HBox spacing="12.0">
                                 <children>
                                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onSubirFoto" styleClass="boton-secundario" text="Subir foto" HBox.hgrow="ALWAYS" />
                                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onQuitarFoto" styleClass="boton-secundario" text="Quitar foto" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <HBox spacing="12.0">
                     <children>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onAgregar" styleClass="boton-principal" text="Agregar" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onModificar" styleClass="boton-principal" text="Modificar" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onEliminar" styleClass="boton-peligro" text="Eliminar" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <HBox spacing="12.0">
                     <children>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onSubir" styleClass="boton-secundario" text="↑ Subir" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onBajar" styleClass="boton-secundario" text="↓ Bajar" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onLimpiar" styleClass="boton-secundario" text="Limpiar" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="12.0" styleClass="panel" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-panel" text="Secciones de la película" />
                  <Label styleClass="etiqueta" text="Se muestran en este orden debajo del detalle, intercaladas: texto | foto, luego foto | texto. Para modificar, eliminar o moverla, seleccione la sección en la tabla. Si no hay ninguna, el detalle no muestra nada abajo." wrapText="true" />
                  <TableView fx:id="tablaSecciones" onMouseClicked="#onSeleccionarSeccion" styleClass="tabla" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colPosicion" prefWidth="60.0" text="#" />
                        <TableColumn fx:id="colEtiqueta" prefWidth="220.0" text="Texto pequeño" />
                        <TableColumn fx:id="colTitulo" prefWidth="300.0" text="Título" />
                        <TableColumn fx:id="colTexto" prefWidth="420.0" text="Texto" />
                        <TableColumn fx:id="colFoto" prefWidth="90.0" text="Foto" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
